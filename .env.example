# ==========================
# Configuración de Modelos
# ==========================
MODELO_TEXTO=qwen2.5:3b
MODELO_VISION=llava:7b
MODELO_EMBEDDINGS=nomic-embed-text
MODELO_EDITOR=qwen2.5:1.5b
MODELO_EDITOR_FALLBACK=qwen2.5:0.5b

# ==========================
# Configuración de Ollama
# ==========================
OLLAMA_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_THREAD=6
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_MS=180000
OLLAMA_MAX_RETRIES=2

# Editor LLM — perfil rápido CPU (modelo separado)
OLLAMA_EDITOR_NUM_CTX=1536
OLLAMA_EDITOR_NUM_PREDICT=256
OLLAMA_EDITOR_TEMPERATURE=0.1
OLLAMA_EDITOR_TIMEOUT_MS=45000
EDITOR_MAX_SOURCE_CHARS=1200
OLLAMA_EDITOR_FALLBACK_NUM_CTX=1024
OLLAMA_EDITOR_FALLBACK_NUM_PREDICT=180
OLLAMA_EDITOR_FALLBACK_TEMPERATURE=0.1
OLLAMA_EDITOR_FALLBACK_TIMEOUT_MS=25000

# ==========================
# Agent Selector
# ==========================
ENABLE_SEMANTIC_ROUTING=false

# ==========================
# Circuit Breaker (Opción C)
# ==========================
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=30000

# ==========================
# Embedding Cache (Opción C)
# ==========================
RAG_EMBEDDING_CACHE_ENABLED=true
RAG_EMBEDDING_CACHE_MAX=2000
RAG_EMBEDDING_CACHE_TTL_MS=21600000

# ==========================
# Context Compression (Opción C)
# ==========================
CONTEXT_COMPRESSION_ENABLED=false
CONTEXT_COMPRESSION_MAX_TOKENS=1024

# ==========================
# RAG Configuration
# ==========================
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=80

# ==========================
# Security (CORS)
# ==========================
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ==========================
# Rate Limiting
# ==========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# ==========================
# Frontend
# ==========================
VITE_API_URL=http://localhost:3000

# ==========================
# Logging
# ==========================
LOG_LEVEL=info

# ==========================
# Editor Config
# ==========================
EDITOR_MAX_SOURCE_CHARS=20000

